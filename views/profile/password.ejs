  <body class="bg-bgDark text-gray-200 min-h-screen flex flex-col">

```
<main class="flex-grow max-w-3xl mx-auto w-full px-4 sm:px-6 py-10">

  <!-- HEADER -->
  <section class="text-center mb-10 relative">

    <div
      class="absolute top-0 left-1/2 -translate-x-1/2 w-40 h-40 bg-accent rounded-full opacity-10 blur-3xl animate-float pointer-events-none"
    ></div>

    <div
      class="relative mx-auto mb-5 w-16 h-16 rounded-2xl bg-cardDark border border-borderDark flex items-center justify-center shadow-glow"
    >
      <i class="fa-solid fa-lock text-2xl text-accent"></i>
    </div>

    <h1 class="text-3xl sm:text-4xl font-bold text-white">
      Changer le mot de passe
    </h1>

    <p class="text-muted mt-2">
      Sécurisez votre compte en mettant à jour votre mot de passe.
    </p>

  </section>


  <!-- PASSWORD CARD -->
  <section
    class="bg-cardDark border border-borderDark rounded-2xl p-5 sm:p-8 shadow-glow"
  >

    <!-- ERROR -->
    <% if (typeof error !== "undefined" && error) { %>
      <div
        class="mb-6 p-4 rounded-xl bg-danger/10 border border-danger/30 text-danger flex items-start gap-3"
      >
        <i class="fa-solid fa-circle-exclamation mt-1"></i>

        <p>
          <%= error %>
        </p>
      </div>
    <% } %>


    <!-- SUCCESS -->
    <% if (typeof success !== "undefined" && success) { %>
      <div
        class="mb-6 p-4 rounded-xl bg-success/10 border border-success/30 text-success flex items-start gap-3"
      >
        <i class="fa-solid fa-circle-check mt-1"></i>

        <p>
          <%= success %>
        </p>
      </div>
    <% } %>


    <form
      action="/profile/password"
      method="POST"
      class="space-y-6"
    >

      <!-- CURRENT PASSWORD -->
      <div>
        <label
          for="current_password"
          class="block text-sm font-semibold text-gray-300 mb-2"
        >
          Mot de passe actuel
        </label>

        <div class="relative">
          <i
            class="fa-solid fa-lock absolute left-4 top-1/2 -translate-y-1/2 text-muted"
          ></i>

          <input
            id="current_password"
            type="password"
            name="current_password"
            class="w-full pl-11 pr-12 py-3 rounded-xl bg-bgDark border border-borderDark text-white focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent transition"
            placeholder="Votre mot de passe actuel"
            required
          />

          <button
            type="button"
            onclick="togglePassword('current_password', this)"
            class="absolute right-4 top-1/2 -translate-y-1/2 text-muted hover:text-accent transition"
            aria-label="Afficher le mot de passe"
          >
            <i class="fa-solid fa-eye"></i>
          </button>
        </div>
      </div>


      <!-- NEW PASSWORD -->
      <div>
        <label
          for="new_password"
          class="block text-sm font-semibold text-gray-300 mb-2"
        >
          Nouveau mot de passe
        </label>

        <div class="relative">
          <i
            class="fa-solid fa-key absolute left-4 top-1/2 -translate-y-1/2 text-muted"
          ></i>

          <input
            id="new_password"
            type="password"
            name="new_password"
            class="w-full pl-11 pr-12 py-3 rounded-xl bg-bgDark border border-borderDark text-white focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent transition"
            placeholder="Votre nouveau mot de passe"
            required
            minlength="8"
          />

          <button
            type="button"
            onclick="togglePassword('new_password', this)"
            class="absolute right-4 top-1/2 -translate-y-1/2 text-muted hover:text-accent transition"
            aria-label="Afficher le mot de passe"
          >
            <i class="fa-solid fa-eye"></i>
          </button>
        </div>

        <p class="text-xs text-muted mt-2">
          Minimum 8 caractères.
        </p>
      </div>


      <!-- CONFIRM PASSWORD -->
      <div>
        <label
          for="confirm_password"
          class="block text-sm font-semibold text-gray-300 mb-2"
        >
          Confirmer le nouveau mot de passe
        </label>

        <div class="relative">
          <i
            class="fa-solid fa-shield-halved absolute left-4 top-1/2 -translate-y-1/2 text-muted"
          ></i>

          <input
            id="confirm_password"
            type="password"
            name="confirm_password"
            class="w-full pl-11 pr-12 py-3 rounded-xl bg-bgDark border border-borderDark text-white focus:outline-none focus:ring-2 focus:ring-accent focus:border-accent transition"
            placeholder="Confirmez votre nouveau mot de passe"
            required
            minlength="8"
          />

          <button
            type="button"
            onclick="togglePassword('confirm_password', this)"
            class="absolute right-4 top-1/2 -translate-y-1/2 text-muted hover:text-accent transition"
            aria-label="Afficher le mot de passe"
          >
            <i class="fa-solid fa-eye"></i>
          </button>
        </div>
      </div>


      <!-- SECURITY INFO -->
      <div
        class="p-4 rounded-xl bg-accent/5 border border-accent/20"
      >
        <div class="flex gap-3">

          <i class="fa-solid fa-shield-halved text-accent mt-1"></i>

          <div>
            <h3 class="font-semibold text-gray-200">
              Votre sécurité
            </h3>

            <p class="text-sm text-muted mt-1">
              Votre nouveau mot de passe sera sécurisé avec un
              algorithme de hachage avant d'être enregistré.
            </p>
          </div>

        </div>
      </div>


      <!-- SUBMIT -->
      <button
        type="submit"
        class="w-full py-3 rounded-xl bg-accent text-black font-semibold hover:brightness-110 active:scale-[0.99] transition-all shadow-glow"
      >
        <i class="fa-solid fa-lock mr-2"></i>
        Modifier le mot de passe
      </button>

    </form>

  </section>


  <!-- QUICK LINKS -->
  <section
    class="mt-8 flex flex-col sm:flex-row justify-center gap-3"
  >

    <a
      href="/dashboard"
      class="px-5 py-2.5 rounded-xl bg-cardDark border border-borderDark text-muted text-center hover:text-accent hover:border-accent/40 transition"
    >
      <i class="fa-solid fa-arrow-left mr-2"></i>
      Retour au Dashboard
    </a>

    <a
      href="/profile/edit"
      class="px-5 py-2.5 rounded-xl bg-cardDark border border-borderDark text-muted text-center hover:text-accent hover:border-accent/40 transition"
    >
      <i class="fa-solid fa-user-gear mr-2"></i>
      Modifier mon profil
    </a>

  </section>

</main>


<%- include("../footer") %>


<!-- PASSWORD VISIBILITY -->
<script>
  function togglePassword(inputId, button) {
    const input = document.getElementById(inputId);
    const icon = button.querySelector("i");

    if (input.type === "password") {
      input.type = "text";
      icon.classList.remove("fa-eye");
      icon.classList.add("fa-eye-slash");
    } else {
      input.type = "password";
      icon.classList.remove("fa-eye-slash");
      icon.classList.add("fa-eye");
    }
  }
</script>
