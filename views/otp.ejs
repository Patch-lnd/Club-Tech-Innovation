<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Validation OTP</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body
    class="bg-gradient-to-r from-blue-400 to-purple-600 min-h-screen flex items-center justify-center font-sans"
  >
    <% include("header") %>
    <!-- Container principal -->
    <div class="bg-white rounded-2xl shadow-2xl p-8 max-w-md w-full">
      <!-- Titre -->
      <h2 class="text-2xl font-bold text-center text-gray-800 mb-4">
        Entrez le code OTP
      </h2>

      <!-- Message dynamique -->
      <% if (message) { %>
      <p class="text-center text-red-500 mb-4"><%= message %></p>
      <% } %>

      <!-- Formulaire OTP -->
      <form action="/verify-otp" method="POST" class="space-y-4">
        <input type="hidden" name="userId" value="<%= userId %>" />

        <!-- Champ OTP -->
        <input
          type="text"
          name="otp"
          placeholder="Code OTP"
          required
          class="w-full px-4 py-3 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-gray-700"
        />

        <!-- Bouton valider -->
        <button
          type="submit"
          class="w-full bg-blue-500 hover:bg-blue-600 text-white font-semibold py-3 rounded-lg transition duration-300"
        >
          Valider
        </button>
      </form>

      <!-- Note -->
      <p class="text-center text-gray-400 text-sm mt-4">
        Un code a été envoyé sur votre email. Il expire dans 5 minutes.
      </p>
    </div>
  </body>
</html>
