<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>404 - Page non trouvée</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Roboto+Mono:wght@400;700&display=swap');

    body {
      margin: 0;
      background: #121212;
      color: #ddd;
      font-family: 'Roboto Mono', monospace;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      text-align: center;
      overflow: hidden;
      position: relative;
    }

    .logo {
      width: 80px;
      height: 80px;
      margin-bottom: 1.5rem;
      fill: #00d1ff;
      filter: drop-shadow(0 0 6px #00d1ff88);
    }

    h1 {
      font-size: 5rem;
      margin: 0;
      color: #00d1ff;
    }

    h2 {
      font-weight: 700;
      font-size: 1.8rem;
      margin: 0.5rem 0 1rem;
      color: #88c0d0;
    }

    p {
      font-size: 1.1rem;
      max-width: 480px;
      color: #bbb;
      margin-bottom: 2rem;
    }

     .return{
      display: inline-block;
      background: #00d1ff;
      color: #121212;
      padding: 0.75rem 2rem;
      border-radius: 30px;
      font-weight: 700;
      text-decoration: none;
      transition: 0.3s;
      box-shadow: 0 5px 15px rgba(0, 209, 255, 0.3);
    }

    .return :hover {
      background: #0fb8e3;
    }

    .illustration {
      width: 280px;
      margin-top: 2rem;
      filter: drop-shadow(0 0 12px rgba(0, 209, 255, 0.1));
    }

    /* Floating tech icons */
    .icon {
      position: absolute;
      width: 40px;
      opacity: 0.07;
      animation: float 12s infinite ease-in-out;
    }

    .icon1 { top: 15%; left: 10%; }
    .icon2 { top: 30%; right: 12%; animation-delay: 2s; }
    .icon3 { bottom: 20%; left: 15%; animation-delay: 4s; }
    .icon4 { bottom: 10%; right: 20%; animation-delay: 1s; }
    .icon5 { top: 50%; left: 45%; animation-delay: 3s; }

    @keyframes float {
      0% { transform: translateY(0px); }
      50% { transform: translateY(-10px); }
      100% { transform: translateY(0px); }
    }
  </style>
</head>
<body>
  <%- include("header.ejs") %>
  <!-- Logo (circuit-tech style) -->
  <svg class="logo" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg">
    <circle cx="32" cy="32" r="30" stroke="#00d1ff" stroke-width="3" fill="none"/>
    <path d="M20 20 L44 20 L44 44 L20 44 Z" stroke="#00d1ff" stroke-width="2" fill="none" />
    <circle cx="32" cy="32" r="5" fill="#00d1ff" />
    <path d="M32 0 V10 M64 32 H54 M32 64 V54 M0 32 H10" stroke="#00d1ff" stroke-width="2"/>
  </svg>

  <h1>404</h1>
  <h2>Page introuvable</h2>
  <p>Cette page n'existe pas ou a été déplacée. Mais tout va bien, vous pouvez revenir tranquillement à l’accueil.</p>
  <a class="return" href="/">Retour à l'accueil</a>

  <!-- Tech illustration -->
  <svg class="illustration" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
    <rect x="20" y="20" width="60" height="60" rx="10" fill="#00d1ff22" stroke="#00d1ff88" stroke-width="2" />
    <path d="M35 40 h30 v20 h-30 z" fill="#00d1ff44" />
    <circle cx="50" cy="50" r="3" fill="#00d1ff" />
  </svg>

  <!-- Floating Icons -->
  <svg class="icon icon1" viewBox="0 0 24 24"><path fill="#00d1ff" d="M3 3h18v18H3z"/></svg>
  <svg class="icon icon2" viewBox="0 0 24 24"><path fill="#00d1ff" d="M12 2l6 6-6 6-6-6z"/></svg>
  <svg class="icon icon3" viewBox="0 0 24 24"><path fill="#00d1ff" d="M4 4h16v2H4z"/></svg>
  <svg class="icon icon4" viewBox="0 0 24 24"><path fill="#00d1ff" d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
  <svg class="icon icon5" viewBox="0 0 24 24"><path fill="#00d1ff" d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"/></svg>

</body>
</html>
