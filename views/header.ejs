<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CETI</title>
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
      integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg=="
      crossorigin="anonymous"
      referrerpolicy="no-referrer"
    />
    <link rel="stylesheet" href="/output.css" />
    <link rel="icon" href="/images/logo-club.png" type="image/png" />
  </head>
  <body>
    <nav>
      <div class="nav-left">
        <a href="/"
          ><img src="/images/logo-club.png" alt="Logo du club" class="logo"
        /></a>
        <!-- previously using class="club-name" and replanced by span on css  -->
        <span>Club Ecologique et Technologies de l'Innovation</span>
      </div>
      <ul>
        <li><a href="/">Accueil</a></li>
        <li><a href="/projects">Projets</a></li>
        <li><a href="/blog">Blog</a></li>
        <li><a href="/apropos">À propos</a></li>
        <!-- <li>
          <a href="/connexion"><i class="fa-regular fa-user"></i></a>
        </li> -->
        <li>
          <% if (user) { %>
          <a href="/dashboard" class="flex items-center">
            <img
              src="<%= user.avatar_url ? user.avatar_url : '/images/default_avatar.png' %>"
              alt="Avatar"
              class="nav-avatar"
            />
            <!-- <span class="ml-2"><%= user.name %></span> -->
          </a>
          <% } else { %>
          <a href="/connexion"><i class="fa-regular fa-user"></i></a>
          <% } %>
        </li>
      </ul>
    </nav>
  </body>
</html>
